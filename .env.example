# Run pnpm demo:setup to create .env with random demo passwords.
# The demo has isolated storage and never connects to an existing database.
# macOS uses nas-docker. Other hosts may set DOCKER_CONTEXT explicitly.
DOCKER_CONTEXT=nas-docker
COMPOSE_PROJECT_NAME=replace-with-unique-checkout-name
POSTGRES_PASSWORD=generate-a-secret
CLICKHOUSE_PASSWORD=generate-a-secret
GRAFANA_CH_PASSWORD=generate-a-secret
GRAFANA_ADMIN_PASSWORD=generate-a-secret
GATEWAY_TOKEN=generate-a-secret
OPENPANEL_CH_PASSWORD=generate-a-secret
COOKIE_SECRET=generate-a-secret
ENCRYPTION_KEY=generate-64-hex-characters
API_URL=http://localhost/api
DASHBOARD_URL=http://localhost
