{
  "id": null,
  "uid": "opg-acquisition",
  "title": "OpenPanel · Acquisition",
  "description": "Session-entry attribution. The date range selects session start time; sign-aware aggregates prevent double counting updates.",
  "tags": [
    "openpanel",
    "analytics",
    "opg"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Session-entry sources",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT if(empty(referrer_name), 'Direct / unknown', referrer_name) AS Source, sum(sign) AS Sessions, sum(screen_view_count * sign) AS Pageviews FROM `${database:raw}`.sessions WHERE $__timeFilter_ms(created_at) AND $__conditionalAll(project_id IN (${project:singlequote}), $project) GROUP BY Source HAVING Sessions > 0 ORDER BY Sessions DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "UTM campaigns",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT utm_source AS Source, utm_medium AS Medium, utm_campaign AS Campaign, sum(sign) AS Sessions FROM `${database:raw}`.sessions WHERE $__timeFilter_ms(created_at) AND $__conditionalAll(project_id IN (${project:singlequote}), $project) GROUP BY Source, Medium, Campaign HAVING Sessions > 0 ORDER BY Sessions DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "Landing pages",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "queryType": "sql",
          "editorType": "sql",
          "rawSql": "SELECT entry_origin AS Site, entry_path AS Path, sum(sign) AS Sessions, 100.0 * sum(toInt64(is_bounce) * sign) / nullIf(sum(sign), 0) AS BouncePercent FROM `${database:raw}`.sessions WHERE $__timeFilter_ms(created_at) AND $__conditionalAll(project_id IN (${project:singlequote}), $project) GROUP BY Site, Path HAVING Sessions > 0 ORDER BY Sessions DESC LIMIT 50",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "OpenPanel ClickHouse",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.3.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.23.2"
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "opg"
      ],
      "title": "OpenPanel dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${DS_CLICKHOUSE}"
        },
        "refresh": 1,
        "query": "SELECT database FROM system.tables WHERE name IN ('events', 'sessions') AND match(database, '^[A-Za-z_][A-Za-z0-9_]*$') GROUP BY database HAVING countDistinct(name) = 2 ORDER BY database",
        "definition": "SELECT database FROM system.tables WHERE name IN ('events', 'sessions') AND match(database, '^[A-Za-z_][A-Za-z0-9_]*$') GROUP BY database HAVING countDistinct(name) = 2 ORDER BY database",
        "current": {
          "text": "openpanel",
          "value": "openpanel"
        },
        "options": []
      },
      {
        "name": "project",
        "label": "Project ID",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${DS_CLICKHOUSE}"
        },
        "refresh": 1,
        "query": "SELECT DISTINCT project_id FROM `${database:raw}`.events ORDER BY project_id",
        "definition": "SELECT DISTINCT project_id FROM `${database:raw}`.events ORDER BY project_id",
        "current": {
          "text": "$__all",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true
      }
    ]
  }
}
